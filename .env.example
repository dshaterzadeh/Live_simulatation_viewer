# Copy this file to .env (gitignored):   cp .env.example .env
#
# .env is the single source of truth for every runtime setting. docker-compose.yml
# injects it into each container (env_file), run.sh sources it for host-side
# runs, and every Python entry point reads it through config.py. There are no
# fallbacks anywhere: a variable that is missing or blank where a value is
# required stops the process with an error naming the variable. Variables
# marked "optional" may be left blank — blank means "not set", never a guess.
#
# Keep comments on their own lines: Docker's env-file parser treats a trailing
# "# comment" as part of the value.
#
# Host addresses are host-side values. docker-compose.yml overrides the three
# that must point at a container instead (MQTT_HOST -> mosquitto,
# HELICS_BROKER_HOST -> helics-broker, FRONTEND_BIND -> 0.0.0.0); the browser
# ones (MQTT_WS_*) are the same in both modes because the browser is always on
# the host.

# --- HELICS federation ---------------------------------------------------
HELICS_BROKER_HOST=127.0.0.1
HELICS_BROKER_PORT=23404
HELICS_CORE=zmq
# Simulation seconds per step; must match the file's dt.
PERIOD=600
# Sim seconds per real second at launch; 0 = free-run. Only the *initial*
# pace — the dashboard changes it live. Pass --pace on the CLI for a one-off
# run instead of changing the shared default.
PACE=600

# --- Replay ------------------------------------------------------------------
# 1 = loop forever, 0 = single bounded pass
LOOP=1
# Optional: integer to pin sensor noise/faults (blank = random)
SEED=
# Optional: ISO 8601 instant of simulation t=0
# (blank = today at local midnight, computed at process start)
SIM_START=
# Bind-mounted into the containers, not baked into the image
HDF5_FILE=20260623_baseline.hdf5

# --- MQTT --------------------------------------------------------------------
MQTT_HOST=127.0.0.1
# TCP listener: bridge, sensors, mosquitto_pub/sub
MQTT_PORT=1883
# WebSocket listener: the browser dashboard
MQTT_WS_PORT=9001
# Telemetry and sensor readings; _meta/* and acks are always QoS 1 + retained
MQTT_QOS=0
TOPIC=sim/coesi5
SENSORS_TOPIC=sensors
# The sensor simulator's own pace, independent of PACE
SENSOR_DELAY=1.0

# --- Frontend ----------------------------------------------------------------
FRONTEND_PORT=8002
FRONTEND_BIND=127.0.0.1
# What the *browser* connects to (with MQTT_WS_PORT)
MQTT_WS_HOST=127.0.0.1
URBANSIM_API_BASE=http://eclab-cloud3.polito.it:8001
# Optional: pre-fill the 3D map's project id
URBANSIM_PROJECT_ID=
